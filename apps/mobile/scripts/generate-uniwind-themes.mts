// Writes the brand palette from src/lib/theme.ts as Uniwind theme CSS, plus a JSON copy that
// native config plugins read. `--check` fails when the committed output is stale.
import * as NodeFS from "node:fs";
import * as NodePath from "node:path";

import { BRAND_THEME, THEME_APPEARANCES } from "../src/lib/theme.ts";

const mobileRoot = NodePath.resolve(import.meta.dirname, "..");

const css = [
  "/* Generated by scripts/generate-uniwind-themes.mts. Do not edit manually. */",
  "@layer theme {",
  "  :root {",
  ...THEME_APPEARANCES.flatMap((appearance) => [
    `    @variant ${appearance} {`,
    ...Object.entries(BRAND_THEME[appearance]).map(([name, value]) => `      ${name}: ${value};`),
    "    }",
  ]),
  "  }",
  "}",
  "",
].join("\n");

const outputs: ReadonlyArray<readonly [file: string, contents: string]> = [
  ["generated-uniwind-themes.css", css],
  ["generated-theme-variables.json", `${JSON.stringify(BRAND_THEME, null, 2)}\n`],
];

const check = process.argv.includes("--check");

for (const [file, contents] of outputs) {
  const path = NodePath.join(mobileRoot, file);
  const current = NodeFS.existsSync(path) ? NodeFS.readFileSync(path, "utf8") : null;

  if (current === contents) continue;

  if (check) {
    console.error(`${file} is stale. Run vp run --filter @dropcap/mobile generate.`);
    process.exitCode = 1;
    continue;
  }

  // Write then rename so Metro never compiles a half-written stylesheet.
  NodeFS.writeFileSync(`${path}.tmp`, contents);
  NodeFS.renameSync(`${path}.tmp`, path);
}
