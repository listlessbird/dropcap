{
  "name": "@kindle-drop/monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "vp config --no-agent",
    "check:changed": "node scripts/check-changed.ts",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "lint": "vp lint --report-unused-disable-directives",
    "typecheck": "vp run -r --cache typecheck",
    "test": "vp run -r test",
    "sync:repos": "node scripts/sync-reference-repos.ts",
    "mobile:install": "node scripts/mobile-native-client.ts"
  },
  "devDependencies": {
    "@oxlint/plugins": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "pnpm@10.33.2"
}
